{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "WebSearch",
      "WebFetch",
      "Task",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(cd *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch --list)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git remote *)",
      "Bash(git stash list)",
      "Bash(git blame *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(pwd)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(type *)",
      "Bash(man *)",
      "Bash(aws s3 ls *)",
      "Bash(aws iam list-roles *)",
      "Bash(aws iam list-policies *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "enableArtifact": false,
  "effortLevel": "medium",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "unity@claude-plugins-official": true
  }
}
